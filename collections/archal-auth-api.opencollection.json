{
  "opencollection": "1.0.0",
  "info": {
    "name": "Archal Auth API",
    "version": "0.3.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the authenticated CLI user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://archal.ai/auth/me"
          },
          "docs": "Get the authenticated CLI user"
        },
        {
          "info": {
            "name": "Start CLI device authentication",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://archal.ai/auth/device"
          },
          "docs": "Start CLI device authentication"
        },
        {
          "info": {
            "name": "Poll a device authentication request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://archal.ai/auth/device/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Poll a device authentication request"
        }
      ]
    }
  ],
  "bundled": true
}